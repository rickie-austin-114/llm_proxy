{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "llm_proxy",
  "version": "0.2.0",
  "identifier": "app.llmproxy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A private localhost proxy for Claude and OpenAI",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "files": {
        "Library/LaunchAgents/app.llmproxy.worker.plist": "macos/app.llmproxy.worker.plist"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "externalBin": ["binaries/llm-proxy-worker"]
  }
}
